<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@android:drawable/ic_input_add"
        android:shortcutShortLabel="@string/shortcut_new_note_short"
        android:shortcutLongLabel="@string/shortcut_new_note_long">
        <intent
            android:action="com.umkt.ucopy.NEW_NOTE"
            android:targetPackage="com.umkt.ucopy"
            android:targetClass="com.umkt.ucopy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="new_todo"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_agenda"
        android:shortcutShortLabel="@string/shortcut_todo_short"
        android:shortcutLongLabel="@string/shortcut_todo_long">
        <intent
            android:action="com.umkt.ucopy.NEW_TODO"
            android:targetPackage="com.umkt.ucopy"
            android:targetClass="com.umkt.ucopy.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="trash"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_delete"
        android:shortcutShortLabel="@string/shortcut_trash_short"
        android:shortcutLongLabel="@string/shortcut_trash_long">
        <intent
            android:action="com.umkt.ucopy.OPEN_TRASH"
            android:targetPackage="com.umkt.ucopy"
            android:targetClass="com.umkt.ucopy.MainActivity" />
    </shortcut>
</shortcuts>
